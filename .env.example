# Belton Live Preview & SCADA Digital Twin Configuration

# Server Port
PORT=8080

# Database Configuration (PostgreSQL Primary)
# For Docker: postgres://belton:belton_password_2026@postgres:5432/belton_scada
# For Local/Cloud: postgres://user:password@hostname:5432/database_name
DATABASE_URL=postgres://belton:belton_password_2026@localhost:5432/belton_scada

# SQLite Fallback Path (Used when PostgreSQL is not connected)
SQLITE_PATH=./data/scada.db

# Ollama AI Model Settings
# For Docker: http://host.docker.internal:11434
# For Local: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen2.5:14b
NUM_GPU=26
NUM_CTX=6144

# TH-AI deployment: existing vLLM chat service (Jenkins sets these automatically)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://host.docker.internal:8000/v1
# MODEL_NAME=Qwen3.6-35B-A3B-AWQ
