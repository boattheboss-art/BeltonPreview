# ============================================================
# BELTON INDUSTRIAL DIGITAL TWIN & AI SCADA FLEET
# Environment Configuration Template
# ============================================================

# Web Server Port (Default: 8080)
PORT=8080

# Local AI Engine (Ollama with Qwen 2.5:14b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen2.5:14b
# Number of layers to force onto GPU (30 = ~94% VRAM on 6GB GPU)
NUM_GPU=30
# Context window size (2048 optimizes VRAM for weights)
NUM_CTX=2048

# Local SQLite Database Path
SQLITE_PATH=./data/scada.db

# Optional: PostgreSQL Database (Uncomment to use PostgreSQL instead of SQLite)
# DATABASE_URL=postgres://user:password@hostname:5432/belton_scada?sslmode=require
